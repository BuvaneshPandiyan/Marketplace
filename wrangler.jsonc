{
  // Point Wrangler at the schema so editors can validate/autocomplete this file
  "$schema": "node_modules/wrangler/config-schema.json",
  // The entry point Worker script — generated by `opennextjs-cloudflare build`, do not edit by hand
  "main": ".open-next/worker.js",
  // The name of this Cloudflare Worker/Pages project — rename to match your chosen app name
  "name": "marketplace-app",
  // The Workers runtime compatibility date — pins behavior so future runtime changes don't break us
  "compatibility_date": "2026-06-01",
  // Enables Node.js compatibility APIs needed by Next.js/OpenNext, plus a stricter fetch security flag
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Tells Cloudflare where the static build output (JS/CSS/images) lives and how to bind it
  "assets": {
    // The folder containing static assets, generated by the OpenNext build step
    "directory": ".open-next/assets",
    // The binding name the Worker code uses internally to reference these assets
    "binding": "ASSETS"
  },
  // A self-reference service binding, required by OpenNext for some internal request handling
  "services": [
    {
      // The binding name the Worker code uses to call back into itself
      "binding": "WORKER_SELF_REFERENCE",
      // The service name MUST match the "name" field above
      "service": "marketplace-app"
    }
  ],
  // NOTE: R2-based incremental caching and Cloudflare Images bindings are intentionally left out
  // of this MVP scaffold to keep setup simple — add them later if ISR caching or image
  // transforms become a priority (see https://opennext.js.org/cloudflare/caching for R2 caching).

  // Cloudflare Cron Triggers — runs the notification job automatically every hour.
  // The cron handler in Workers fires a scheduled() event; since we're using opennextjs-cloudflare
  // which wraps everything as a fetch handler, we configure the trigger to POST to our API route
  // instead. See SETUP.md for how to wire the Cloudflare Dashboard → Workers → Cron Triggers
  // to send a POST to https://your-domain/api/cron/notifications with the x-cron-secret header.
  // Alternatively you can use Supabase's pg_cron extension to call this endpoint via a
  // net.http_post() call if you prefer everything managed in Supabase.
  "triggers": {
    // Run every hour — adjust the cron expression if you need a different schedule
    "crons": ["0 * * * *"]
  }
}
