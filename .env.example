# ============================================================================
# MARKETPLACE APP — ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local for local development.
# For Cloudflare Pages production deployment:
#   - NEXT_PUBLIC_* vars → set as "Environment Variables" in Cloudflare Pages
#   - Secret vars (no NEXT_PUBLIC_) → set as "Secrets" in Cloudflare Pages
#   - Never commit .env.local or any file containing real secret values to git.
# ============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Both values are found in: Supabase Dashboard → Project Settings → API

# PUBLIC — safe to expose in the browser. This is the URL of your Supabase project.
# Cloudflare Pages: set as a plain Environment Variable (not a secret).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# PUBLIC — the anon key is designed to be public; RLS policies protect the data.
# Cloudflare Pages: set as a plain Environment Variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SECRET — the service-role key bypasses ALL Row Level Security.
# NEVER expose this in the browser or commit it to git.
# Cloudflare Pages: set as a Secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App URL ───────────────────────────────────────────────────────────────────
# The canonical public URL of your deployed app.
# Used to build absolute URLs in transactional emails and OG meta tags.
# Cloudflare Pages: set as a plain Environment Variable.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Meilisearch ───────────────────────────────────────────────────────────────
# Meilisearch is a self-hosted or cloud-hosted search engine (not Supabase built-in).
# See DEPLOY.md for how to spin up a Meilisearch instance.

# PUBLIC — the base URL of your Meilisearch instance. No trailing slash.
# For local dev with Docker: http://localhost:7700
# For production: https://search.yourdomain.com or your Meilisearch Cloud URL
# Cloudflare Pages: set as a plain Environment Variable.
MEILISEARCH_HOST=https://search.yourdomain.com

# SECRET — the Meilisearch master key / admin API key.
# Used only server-side to index/sync documents. Never sent to the browser.
# Cloudflare Pages: set as a Secret.
MEILISEARCH_API_KEY=your_meilisearch_master_key

# ── Firebase Cloud Messaging (Push Notifications) ────────────────────────────
# All NEXT_PUBLIC_FIREBASE_* values come from:
#   Firebase Console → Project Settings → General → Your apps → SDK config
# The VAPID key comes from:
#   Firebase Console → Project Settings → Cloud Messaging → Web Push certificates

# PUBLIC — safe in the browser (identifies your Firebase project to the browser SDK)
# Cloudflare Pages: set all NEXT_PUBLIC_FIREBASE_* as plain Environment Variables.
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# PUBLIC — the VAPID key pair's public key; required by the browser to validate FCM tokens
# Cloudflare Pages: set as a plain Environment Variable.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BK...

# SECRET — the Firebase service account JSON (private key for server-side FCM HTTP v1 sends).
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
# Paste the ENTIRE JSON as a single-line string value (escape the internal quotes).
# Cloudflare Pages: set as a Secret.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# ── Resend (Transactional Email) ──────────────────────────────────────────────
# Free tier: 3,000 emails/month. Sign up at https://resend.com
# Requires verifying a sending domain (or use onboarding@resend.dev for testing).

# SECRET — the Resend API key for sending emails server-side.
# Cloudflare Pages: set as a Secret.
RESEND_API_KEY=re_...

# PUBLIC-ISH — the "From" address on all outgoing emails. Must be a verified Resend sender.
# For testing you can use: onboarding@resend.dev (Resend's sandbox address)
# Cloudflare Pages: set as a plain Environment Variable.
EMAIL_FROM=noreply@yourdomain.com

# ── Cron Job Authentication ────────────────────────────────────────────────────
# A long random secret string used to authenticate the Cloudflare Cron Trigger's
# POST to /api/cron/notifications. Generate with: openssl rand -base64 32
# Set in BOTH your Next.js env AND the Cloudflare Pages environment variables.
# Cloudflare Pages: set as a Secret.
CRON_SECRET=your_long_random_secret_string

# ── Geocoding (OpenStreetMap Nominatim) ───────────────────────────────────────
# Nominatim is free to use; providing a contact email in the User-Agent is required
# by their usage policy (https://operations.osmfoundation.org/policies/nominatim/).
# Not a secret — just identifies you to OSM if your usage needs attention.
# Cloudflare Pages: set as a plain Environment Variable.
NOMINATIM_CONTACT_EMAIL=your@email.com
